---
import BlogLayout from '../layouts/BlogPost.astro';
import ContactHeroImage from '../assets/blog-placeholder-about.jpg';

const title = 'Contact';
const description = 'Get in touch to discuss your needs, ask questions, or book an introductory meeting.';
---

<BlogLayout
  title="Contact"
  description={description}
  pubDate={new Date()}          // required by layout, but we’ll hide it
  updatedDate={undefined}
  heroImage={undefined}
  authors={[]}                  // no authors on contact page
  tags={[]}                     // no tags on contact page
  id={'contact'}
  headings={[]}                 // no TOC
  toc={false}
>
  <section class="contact-section">
    <div class="contact-intro">
      <p>
        To discuss your needs further you can either fill out the contact form below,
        email me directly, or book a free introductory meeting.
      </p>
      <div class="contact-alt">
        <p>
          Email:
          <a href="mailto:endre.sebestyen@runbox.com">endre.sebestyen@runbox.com</a>
        </p>
        <p>
          Book a meeting:
          <a href="https://calendly.com/your-link" target="_blank" rel="noopener noreferrer">
            Schedule a call
          </a>
        </p>
      </div>
    </div>

    <div class="contact-card">
      <form
        class="contact-form"
        method="post"
        action="https://formsubmit.co/endre.sebestyen@runbox.com"
      >
        <div class="field-group">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required />
        </div>

        <div class="field-group">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required />
        </div>

        <div class="field-group">
          <label for="subject">Subject</label>
          <input id="subject" name="subject" type="text" />
        </div>

        <div class="field-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="contact-submit">Send message</button>
      </form>
    </div>
  </section>

  <style>
    .contact-section {
      max-width: 720px;
      margin: 0 auto;
      padding: 0 1.5rem 4rem;
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .contact-intro h1 {
      margin-bottom: 0.75rem;
      text-align: left;
    }

    .contact-intro p {
      margin-bottom: 0.75rem;
      text-align: left;
    }

    .contact-alt p {
      margin: 0.25rem 0;
    }

    .contact-alt a {
      text-decoration: underline;
    }

    .contact-card {
      border-radius: 0.75rem;
      padding: 2rem 1.75rem;
      background-color: var(--color-surface, #ffffff);
      box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.08));
    }

    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }

    .field-group label {
      font-weight: 500;
    }

    .field-group input,
    .field-group textarea {
      width: 100%;
      padding: 0.6rem 0.75rem;
      font-size: 1rem;
      border-radius: 0.5rem;
      border: 1px solid var(--color-border, #d4d1ca);
      background-color: var(--color-surface-2, #fbfbf9);
    }

    .field-group input:focus-visible,
    .field-group textarea:focus-visible {
      outline: 2px solid var(--color-primary, #01696f);
      outline-offset: 2px;
    }

    .contact-submit {
      margin-top: 0.5rem;
      padding: 0.7rem 1.2rem;
      border-radius: 999px;
      border: none;
      font-size: 1rem;
      font-weight: 500;
      color: var(--color-text-inverse, #ffffff);
      background-color: var(--color-primary, #01696f);
      cursor: pointer;
      transition: background-color 160ms ease, transform 120ms ease;
    }

    .contact-submit:hover {
      background-color: var(--color-primary-hover, #0c4e54);
      transform: translateY(-1px);
    }

    .contact-submit:active {
      background-color: var(--color-primary-active, #0f3638);
      transform: translateY(0);
    }

    @media (max-width: 640px) {
      .contact-card {
        padding: 1.5rem 1.25rem;
      }

      .contact-section {
        padding-inline: 1.25rem;
      }
    }
  </style>
</BlogLayout>