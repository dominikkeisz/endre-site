---
import BlogLayout from '../layouts/BlogPost.astro';
import ServiceIcon from '../components/ServiceIcon.astro';

const description = 'Detailed list of offered services and solutions.';

const services = [
  {
    icon: 'rna' as const,
    title: 'Transcriptomics Analysis & Pipeline Engineering',
    text: 'Reproducible pipelines that turn raw reads (FASTQ), alignments (BAM/CRAM), or count matrices into biological discoveries — QC, de novo assembly, isoform annotation, alternative splicing, and differential expression.',
  },
  {
    icon: 'population' as const,
    title: 'Population Genetics & Association Studies',
    text: 'QC and statistical analysis for population-scale variant data (VCF/BGEN/PLINK) — GWAS/PheWAS, fine-mapping, colocalization, and Mendelian Randomization, at UK Biobank / All of Us scale.',
  },
  {
    icon: 'network' as const,
    title: 'Multi-Omics Integration & Prioritization',
    text: 'Unified workflows across genomics, transcriptomics, epigenomics, and RNA-protein dynamics, layered with CRISPR/RNAi screens to build one cohesive map of gene regulation and variant impact.',
  },
  {
    icon: 'chart' as const,
    title: 'Scientific Advisory & Data Visualization',
    text: 'Publication-ready visualizations and data packages for grants and manuscripts, plus rigorous peer review of bioinformatics deliverables and objective scientific advisory.',
  },
];
---

<BlogLayout
  title="Services & Solutions"
  description={description}
  pubDate={new Date()}
  updatedDate={undefined}
  heroImage={undefined}
  authors={[]}
  tags={[]}
  id={'services'}
  headings={[]}
  toc={false}
>
  <section class="svc-section">
    <header class="svc-header">
      <p class="svc-intro">Four ways to work together, from <em>raw sequence</em> to <em>strategic sign-off</em>.</p>
    </header>

    <div class="svc-grid">
      {services.map((service) => (
        <article class="svc-card">
          <div class="svc-card-icon">
            <ServiceIcon name={service.icon} size={28} />
          </div>
          <h3>{service.title}</h3>
          <p>{service.text}</p>
        </article>
      ))}
    </div>

    <div class="svc-band">
      <div class="band-col">
        <div class="band-icon"><ServiceIcon name="clock" size={26} /></div>
        <div>
          <h4>Pricing Structure</h4>
          <p>Services are billed on an hourly basis to accommodate the iterative nature of bioinformatics workflows. Research objectives — whether within academia, early-stage startups, or pharmaceutical corporations — frequently shift based on interim data findings, and hourly billing keeps the agility to modify deliverables, pivot analytical pipelines, and adjust timelines without the constraints of a fixed-price contract. Budget estimates and monthly caps can be established prior to project initiation for financial predictability.</p>
        </div>
      </div>
      <div class="band-divider" aria-hidden="true"></div>
      <div class="band-col">
        <div class="band-icon"><ServiceIcon name="server" size={26} /></div>
        <div>
          <h4>Computing &amp; Infrastructure Costs</h4>
          <p>All fees relate strictly to consulting hours. External expenses associated with computational infrastructure — including cloud compute instances, high-performance storage, data egress/transfer fees, and repository backups — are billed directly to the client or provisioned within the client&rsquo;s own cloud environment. The only exceptions are low-overhead tasks executed locally on the consultant&rsquo;s workstation, such as final downstream statistical modeling or tabular data visualization.</p>
        </div>
      </div>
    </div>
  </section>

  <style>
    :global(.blog-container) {
      max-width: 1320px !important;
    }
    :global(.prose-wrapper) {
      width: 100% !important;
    }

    .svc-section {
      max-width: 1320px;
      margin: 0 auto;
      padding: 0.5rem 1.5rem 5rem;
    }

    .svc-header {
      margin: 0 0 2.25rem;
      border-left: 3px solid var(--color-accent);
      padding-left: 1.5rem;
    }
    .svc-intro {
      margin: 0;
      max-width: 52ch;
      color: var(--color-text-main);
      font-family: var(--font-serif);
      font-size: 1.55rem;
      font-weight: 400;
      line-height: 1.35;
    }
    .svc-intro em {
      color: var(--color-accent);
      font-style: italic;
    }

    .svc-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .svc-card {
      border: 1px solid var(--color-border);
      border-radius: 1.25rem;
      background-color: var(--color-bg);
      padding: 2.25rem;
      box-shadow: var(--shadow-sm);
      transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
    }
    .svc-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow-lg, var(--shadow-md));
      border-color: color-mix(in srgb, var(--color-accent) 30%, var(--color-border));
    }

    .svc-card-icon {
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 999px;
      background-color: var(--color-accent-light);
      color: var(--color-accent);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.25rem;
    }
    html[data-theme='dark'] .svc-card-icon {
      color: #ffffff;
    }

    .svc-card h3 {
      margin: 0 0 0.65rem;
      color: var(--color-text-main);
      font-size: 1.18rem;
    }
    .svc-card p {
      margin: 0;
      color: var(--color-text-muted);
      font-size: 0.96rem;
      text-align: left;
    }

    .svc-band {
      --on-accent: #ffffff;
      margin-top: 2rem;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: start;
      gap: 2.5rem;
      border-radius: 1.5rem;
      background-color: var(--color-accent);
      color: var(--on-accent);
      padding: 2.75rem 3rem;
      box-shadow: var(--shadow-lg, var(--shadow-md));
    }
    html[data-theme='dark'] .svc-band {
      --on-accent: var(--color-bg);
    }

    .band-col {
      display: flex;
      align-items: flex-start;
      gap: 1.1rem;
    }
    .band-icon {
      flex-shrink: 0;
      color: var(--on-accent);
      opacity: 0.9;
      margin-top: 0.15rem;
    }
    .band-col h4 {
      margin: 0 0 0.4rem;
      color: var(--on-accent);
      font-size: 1.05rem;
    }
    .band-col p {
      margin: 0;
      color: var(--on-accent);
      opacity: 0.85;
      font-size: 0.92rem;
      text-align: left;
    }
    .band-divider {
      width: 1px;
      align-self: stretch;
      background-color: var(--on-accent);
      opacity: 0.25;
    }

    @media (max-width: 860px) {
      .svc-grid {
        grid-template-columns: 1fr;
      }
      .svc-band {
        grid-template-columns: 1fr;
        gap: 1.75rem;
        padding: 2rem 2.25rem;
      }
      .band-divider {
        width: auto;
        height: 1px;
      }
    }

    @media (max-width: 640px) {
      .svc-section {
        padding: 1.5rem 1.25rem 3.5rem;
      }
      .svc-header {
        padding-left: 1.1rem;
      }
      .svc-intro {
        font-size: 1.28rem;
      }
      .svc-card {
        padding: 1.75rem;
      }
    }
  </style>
</BlogLayout>
